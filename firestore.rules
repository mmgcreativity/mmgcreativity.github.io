rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read: if request.auth != null && (request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /meta/counters {
      allow read, write: if request.auth != null;
    }
    // ---- Kullanıcı Profili (sosyal profil sayfası — profil.html) ----
    // users/{uid} dokümanını yalnızca sahibi/yönetici okuyabildiği için, başka
    // kullanıcıların GÖREBİLECEĞİ herkese açık profil verisi ayrı bir üst düzey
    // "profiles/{uid}" koleksiyonunda tutulur.
    //  • read  : giriş yapmış her kullanıcı başka bir kullanıcının profilini okuyabilir.
    //            (Açık/Gizli ayrımı istemci tarafında uygulanır; burada hassas kimlik
    //             verisi tutulmaz — sadece kullanıcının kendi paylaştığı profil alanları.)
    //  • write : yalnızca profilin sahibi (doküman ID'si == kendi uid'i) yazabilir.
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /referralCodes/{code} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    // Referans kullanım kaydı. Üst doküman yalnızca sayaç/son-kullanım tutar (kişisel veri YOK);
    // kayıt (signup) sırasında maxUses kontrolü için okunması ve sayacın artırılması gerektiğinden
    // giriş yapan kullanıcıya açık. HASSAS veri (katılanların e-posta/kullanıcı adı/müşteri no)
    // alt koleksiyon "users" içinde tutulur ve GÜVENLİK DARALTMASI ile korunur:
    //  • Katılan kişi yalnızca KENDİ kaydını oluşturabilir.
    //  • Bu kayıtları yalnızca kişinin kendisi, kodun SAHİBİ (satış ortağı) veya yönetici okuyabilir
    //    — böylece bir başkası senin referans girişlerinin e-postalarını toplayamaz.
    match /referrals/{code} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      match /users/{memberUid} {
        allow read: if request.auth != null && (
          request.auth.uid == memberUid ||
          get(/databases/$(database)/documents/referralCodes/$(code)).data.ownerUid == request.auth.uid ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        );
        allow create: if request.auth != null && request.auth.uid == memberUid;
        allow update, delete: if request.auth != null && (
          get(/databases/$(database)/documents/referralCodes/$(code)).data.ownerUid == request.auth.uid ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        );
      }
    }
    // Bir referans koduyla kayıt olan yeni kullanıcıyı, o kodun sahibine (ownerUid) bildirmek
    // için oluşturulan kayıt. Yeni kullanıcı kendi kaydını oluşturabilir; sadece kodun sahibi
    // ya da site yöneticisi bu kayıtları okuyabilir.
    match /referralSignups/{docId} {
      allow create: if request.auth != null && request.resource.data.newUserUid == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }
    match /feedback/{entryId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ---- Kullanım istatistikleri (hangi araç ne sıklıkla açılıyor) ----
    // EKSİKTİ: Bu koleksiyon için hiç kural olmadığından varsayılan olarak REDDEDİLİYORDU;
    // bu yüzden araç açılışları bir haftadır hiç kaydedilmiyor ("Kullanım verisi okunamadı").
    //  • write: giriş yapmış her kullanıcı kendi açılışını sayabilsin (totalCount +1).
    //  • read : yalnızca yönetici (İstatistikler paneli) okuyabilsin.
    match /usageStats/{target} {
      allow write: if request.auth != null;
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      match /openers/{uid} {
        allow write: if request.auth != null && request.auth.uid == uid;
        allow read: if request.auth != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      }
    }
    // İstatistikler paneli usageStats verisini collectionGroup('openers') ile okur.
    // KRİTİK: Koleksiyon-grubu sorguları, yukarıdaki nested (usageStats/{target}/openers/{uid})
    // kuralıyla YETKİLENDİRİLMEZ — Firestore bunun için recursive wildcard kuralı ister.
    // Bu kural olmadan yönetici olsa bile sorgu REDDEDİLİP "Kullanım verisi okunamadı" veriyordu.
    match /{path=**}/openers/{uid} {
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ---- Bildirimler (çan/badge) ----
    // Davet gönderme, referans kullanımı, hatırlatma vb. olaylarda alıcıya (toUid) bir bildirim
    // yazılır. Alıcı kendi bildirimlerini okuyabilir/okundu işaretleyebilir/silebilir; giriş
    // yapmış herhangi bir kullanıcı başka bir kullanıcıya bildirim OLUŞTURABİLİR (davet eden
    // kişi, referans sahibine bildirim yazan yeni kullanıcı vb.). fromUid, oluşturanın kimliği.
    match /notifications/{notifId} {
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      allow read, update, delete: if request.auth != null && (
        resource.data.toUid == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }

    // ---- Sohbet Widget'ı ----
    match /chatCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    // Kullanıcı Kodu → görünen ad eşlemesi (herkese açık, sadece kendi kaydını yazabilir).
    // Örn. Kullanıcı Yönetim Paneli'ndeki bekleyen davetlerde, firma yöneticisinin başka
    // kullanıcıların özel profiline erişmeden sadece görünen adını görebilmesi için kullanılır.
    match /userDirectory/{code} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
    // Kullanıcı adı rezervasyonu: aynı kullanıcı adıyla ikinci kez kayıt
    // olunamasın diye, doküman ID'si kullanıcı adının küçük harfli hali.
    // "create" izni tek seferliktir — doküman zaten varsa create başarısız
    // olur (update izni verilmediği için bir kez alınan isim asla değişip
    // başkasına devredilemez).
    match /usernames/{lowercaseUsername} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /chatRequests/{reqId} {
      allow read: if request.auth != null && (
        resource == null ||
        resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.toUid == request.auth.uid;
      allow delete: if request.auth != null &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }
    match /chats/{chatId} {
      allow read: if request.auth != null && (
        resource == null ||
        request.auth.uid in resource.data.participants ||
        (resource.data.isAdminChat == true &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      );
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.participants ||
        (resource.data.isAdminChat == true &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      );
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;

      match /messages/{msgId} {
        allow read: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants ||
          (get(/databases/$(database)/documents/chats/$(chatId)).data.isAdminChat == true &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
        );
        allow create: if request.auth != null && request.resource.data.senderUid == request.auth.uid;
      }
    }

    // ---- Sohbet Widget'ı: Grup Sohbetleri ----
    // Not: "chatGroups" / "chatGroupInvites" adları kasıtlı olarak "groups" değil —
    // sitede zaten Firma/Ekip birleştirme için ayrı bir "groups" koleksiyonu var (aşağıda).
    match /chatGroupInvites/{inviteId} {
      allow read: if request.auth != null && (
        resource == null ||
        resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.toUid == request.auth.uid;
      allow delete: if request.auth != null &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }
    match /chatGroups/{groupId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members ||
        exists(/databases/$(database)/documents/chatGroupInvites/$(groupId + '_' + request.auth.uid))
      );

      match /messages/{msgId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/chatGroups/$(groupId)).data.members;
        allow create: if request.auth != null && request.resource.data.senderUid == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/chatGroups/$(groupId)).data.members;
      }
    }

    // ---- Firma / Ekip (index.html'deki "Firma/Ekip" özelliği hâlâ kullanıyor) ----
    // GÜVENLİK DARALTMASI: Eskiden bu koleksiyon giriş yapan HERKESE tam okuma/yazma açıktı;
    // bu, bir kullanıcının başka bir firmanın üye e-postalarını okuyup verisini değiştirebilmesi
    // demekti. Artık:
    //  • Şirket dokümanı (name/ownerUid/groupId — hassas değil) okunabilir kalıyor; çünkü firma
    //    kurarken isim-tekrar kontrolü (where name==...) ve davetle katılım bunu gerektiriyor.
    //  • Şirket dokümanına YAZMA yalnızca kuran/sahip (ownerUid) tarafından yapılabilir.
    //  • Hassas kısım olan "members" (üye e-postaları) yalnızca o firmanın üyeleri/sahibi
    //    tarafından okunabilir; üyeliği yalnızca kişinin kendisi oluşturabilir; silme kişinin
    //    kendisi veya firma sahibi tarafından yapılabilir.
    match /companies/{companyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.ownerUid == request.auth.uid;

      match /members/{memberUid} {
        allow read: if request.auth != null && (
          request.auth.uid == memberUid ||
          get(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid == request.auth.uid ||
          exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid))
        );
        allow create: if request.auth != null && request.auth.uid == memberUid;
        allow delete: if request.auth != null && (
          request.auth.uid == memberUid ||
          get(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid == request.auth.uid
        );
      }
    }
    // ESKİ e-posta tabanlı davet (companies sistemi). Artık davetler KOD tabanlı yapılıyor
    // (firmaInvites/{kod}, firmaAdminInvites/{kod}) ve bu koleksiyona hiçbir yer YAZMIYOR.
    // Güvenlik: yazmayı tamamen kapatıyoruz (aksi halde biri sahte bir invites/{kurban-eposta}
    // kaydı oluşturup, kurban giriş yaptığında onu kendi firmasına ekletebilirdi). Okuma da
    // yalnızca kendi e-postasına ait kayıtla sınırlı — böylece e-posta adresleri sızmaz.
    match /invites/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false;
    }
    match /groups/{groupId} {
      allow read, write: if request.auth != null;
    }

    // ---- Firma Hesabı (YENİ, ayrı giriş bilgisine sahip firma/admin hesapları) ----
    // Bunlar kişisel "users" hesaplarından tamamen bağımsız, kendi e-posta/şifresiyle
    // giriş yapan, veri girişi yapamayan, sadece kullanıcı ekleyip yetkilendiren hesaplar.
    match /firmaAccounts/{firmaId} {
      allow read, write: if request.auth != null;
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }
    match /firmaInvites/{code} {
      allow read, write: if request.auth != null;
      // Bir kullanıcı kodu aynı anda birden fazla firmaya kullanıcı olarak davet edilebilsin diye
      // her firma davetini ayrı bir alt kayıt olarak tutuyoruz (KullaniciYonetimi.html'deki
      // "birden fazla firmaya bir kerede davet gönder" özelliği için).
      match /firmas/{firmaId} {
        allow read, write: if request.auth != null;
      }
    }
    match /firmaAdminInvites/{email} {
      allow read, write: if request.auth != null;
    }
    // ---- Blog (adminin yazıları direkt yayında; diğer kullanıcılarınki admin onayına düşer) ----
    // status: 'published' (herkese görünür) | 'pending' (sadece yazan kişi + admin görebilir).
    match /blogPosts/{postId} {
      allow read: if request.auth != null && (
        resource.data.status == 'published' ||
        resource.data.authorUid == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
      allow create: if request.auth != null &&
        request.resource.data.authorUid == request.auth.uid &&
        (
          (request.resource.data.status == 'published' &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true) ||
          (request.resource.data.status == 'pending' &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin != true)
        );
      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
        (
          resource.data.authorUid == request.auth.uid &&
          request.resource.data.authorUid == resource.data.authorUid &&
          request.resource.data.status == 'pending'
        )
      );
      allow delete: if request.auth != null && (
        resource.data.authorUid == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }

    // ---- Forum (basit akış: herkes mesaj atar, alt alta sıralanır) ----
    match /forumPosts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorUid == request.auth.uid;
      // Beğeni/tekrarla (like/repost) sadece kendi uid'ini likes/repostUids
      // dizisine ekleyip çıkarabilsin diye, ve yanıt sayısı (replyCount) artıp
      // azalabilsin diye izin veriyoruz; gönderi metnini başkası değiştiremez.
      allow update: if request.auth != null && (
        resource.data.authorUid == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes','repostUids','replyCount'])
      );
      allow delete: if request.auth != null && (
        resource.data.authorUid == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );

      match /replies/{replyId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.authorUid == request.auth.uid;
        allow delete: if request.auth != null && (
          resource.data.authorUid == request.auth.uid ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        );
      }
    }
  }
}
